{
  "name": "atlas-express-quickstart",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Minimal Express API protected by Atlas auth (@atlasauth/express) + a static sign-in page using @atlasauth/js.",
  "scripts": {
    "build:client": "esbuild src/signin.js --bundle --format=esm --outfile=public/signin.bundle.js",
    "dev": "npm run build:client && node --watch src/server.js",
    "start": "npm run build:client && node src/server.js"
  },
  "dependencies": {
    "@atlasauth/express": "^0.1.0",
    "@atlasauth/js": "^0.2.0",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "esbuild": "^0.24.2"
  }
}
