# Atlas + Express quickstart — copy to .env and fill in your instance's values.
# Load it with `node --env-file=.env src/server.js` (Node 20+) or your own loader.

# Server-side JWT verification (used by @atlasauth/express). No secret key is
# needed — verification is LOCAL against the instance JWKS.
ATLAS_JWKS_URL=https://atlasauth.net/.well-known/jwks.json
ATLAS_ISSUER=https://atlasauth.net

# Publishable key (safe to expose to the browser) — handed to the static sign-in
# page via /config.json.
ATLAS_PUBLISHABLE_KEY=pk_test_xxx

# The instance's Frontend API origin (where @atlasauth/js talks to). On the
# hosted fleet this is the shared host until you verify a custom domain.
ATLAS_FRONTEND_API=https://atlasauth.net

PORT=3000
