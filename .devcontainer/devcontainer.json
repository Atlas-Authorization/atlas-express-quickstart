{
  "name": "Atlas Express quickstart",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:20",
  "forwardPorts": [
    3000
  ],
  "postCreateCommand": "npm install && (cp -n .env.example .env.local 2>/dev/null || cp -n .env.example .env 2>/dev/null || true)",
  "postAttachCommand": {
    "note": "echo 'Set your Atlas publishable/secret keys in the .env file, then: npm run dev (http://localhost:3000)'"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode"
      ]
    }
  }
}
